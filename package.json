{
  "name": "agent-cockpit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Hierarchical multi-agent coding cockpit: Opus supervises, Codex leads, workers build in isolated git worktrees.",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "cockpit": "./bin/cockpit.mjs"
  },
  "scripts": {
    "cockpit": "node bin/cockpit.mjs",
    "daemon": "node bin/cockpit.mjs daemon",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "tsx": "^4.20.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0",
    "@opentelemetry/core": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
