{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["hooks/**/*", "types/**/*", "tests/**/*.ts", "tests/**/*.tsx", ".claude/types/**/*.d.ts"],
  "exclude": ["tests/bench.ts", "tests/pane.test.tsx"]
}
